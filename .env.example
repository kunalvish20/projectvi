# PROJECT VI — Copy to .env and replace values. NEVER commit or share .env.
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_PUBLIC_ANON_KEY
# Server only: these MUST NOT begin with VITE_ and MUST NOT be exposed in browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SECRET_SERVICE_ROLE_KEY

# PayU India > Merchant Dashboard > Merchant Key and Salt
PAYU_MERCHANT_KEY=PASTE_PAYU_MERCHANT_KEY
PAYU_MERCHANT_SALT=PASTE_PAYU_MERCHANT_SALT
PAYU_ENV=test

# HTTPS public origin in production. For local PayU callback tests use a HTTPS tunnel.
# No trailing slash.
PUBLIC_SITE_URL=https://YOUR-PUBLIC-SITE.example

# Used only by npm run setup:admins from the gitignored .env.local file.
# Use a NEW unique strong password; never store a real password in this example.
ADMIN_INITIAL_PASSWORD=SET_NEW_STRONG_ADMIN_PASSWORD_HERE
